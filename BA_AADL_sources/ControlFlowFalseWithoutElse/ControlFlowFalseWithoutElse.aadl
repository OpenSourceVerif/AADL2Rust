-- Unit-Rules: F12
-- Unit-Target: All false branches without else leave the prior value unchanged.
-- Unit-Environment: paired-ports-v1
-- One owning thread and BA; external test inputs use the original ports.
-- Unit-Isolation: v1
-- Auxiliary prerequisites are checked separately; a blocked prerequisite is not a target failure.
package ControlFlowFalseWithoutElse_Example
public
  with Data_Model;
  
  with Base_Types;

  -- Auxiliary storage preserves model widths, signs and array shapes.
  data Boolean
    properties Data_Model::Data_Representation => Boolean;
  end Boolean;

  data Signed32
    properties
      Data_Model::Data_Representation => Integer;
      Data_Model::Number_Representation => Signed;
      Source_Data_Size => 4 Bytes;
  end Signed32;


  thread Worker
    features
      -- Auxiliary peer ports are never read or written by this BA.
      unit_trigger : in event data port Base_Types::Boolean;
      unit_probe_out : out event data port Base_Types::Boolean;
  end Worker;

  thread implementation Worker.impl
    properties
      Dispatch_Protocol => Periodic;
      Priority => 1;
      Period => 10 ms;
    annex behavior_specification {**
      variables
        retained_value : Signed32;
        branch_count : Signed32;
      states
        s_ready : initial complete final state;
      transitions
        s_ready -[on dispatch]-> s_ready {
          -- Unit-Setup-BEGIN
          retained_value := 7;
          branch_count := 0;
          -- Unit-Setup-END
          -- Unit-Target-BEGIN: F12
          if (false) retained_value := 99; branch_count := branch_count + 1
          elsif (false) retained_value := 88; branch_count := branch_count + 1
          end if
          -- Unit-Target-END
        };
    **};
  end Worker.impl;

  -- Shared single-thread Unit deployment with inert, explicitly connected peers.
  process Light_Test_Process end Light_Test_Process;
  process implementation Light_Test_Process.impl
    subcomponents worker : thread Worker.impl;
    connections
      inert_pair : port worker.unit_probe_out -> worker.unit_trigger;
  end Light_Test_Process.impl;
  processor Light_Test_Cpu
    end Light_Test_Cpu;
  system Light_Test_System end Light_Test_System;
  system implementation Light_Test_System.impl
    subcomponents application : process Light_Test_Process.impl;
      cpu : processor Light_Test_Cpu;
    properties Actual_Processor_Binding => reference(cpu) applies to application;
  end Light_Test_System.impl;
end ControlFlowFalseWithoutElse_Example;
